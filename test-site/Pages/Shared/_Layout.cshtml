<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Test site</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="htmx-config" content='{"includeIndicatorStyles":false}' />
    <script src="~/js/htmx.min.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
</head>
@{
    bool hideHeader = ViewData["HideHeader"] is true;
}

<body>
    @if (!hideHeader)
    {
        <partial name="_Header.cshtml" />
    }

    <main role="main" class="page-width @(hideHeader ? "no-top-margin" : "")">
        @RenderBody()
    </main>

    <partial name="_Footer.cshtml" />

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>